#!/bin/sh
set -eu
# contentHash: {{ include "dot_config/systemd/user/kanshi.service" | sha256sum }}

if [ -n "${XDG_RUNTIME_DIR:-}" ] && systemctl --user show-environment >/dev/null 2>&1; then
    systemctl --user daemon-reload
    systemctl --user enable --now kanshi.service
else
    echo "No active user systemd/D-Bus session detected; run manually later:"
    echo "  systemctl --user enable --now kanshi.service"
fi
