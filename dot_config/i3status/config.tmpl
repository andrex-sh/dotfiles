# i3status 2.14 — sway laptop, plain-text labels
general {
        colors = true
        interval = 5
        color_good = "#a6e3a1"
        color_degraded = "#f9e2af"
        color_bad = "#f38ba8"
        # Pin the protocol explicitly: i3status auto-detects this based on
        # how it's invoked, and guesses wrong (falls back to plain text) when
        # run from anything other than the real bar, which breaks the
        # keyboard-layout wrapper script's JSON parsing.
        output_format = "i3bar"
}

# Left-to-right order shown in the bar
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "wireless {{ .wifi_interface }}"
order += "battery 0"
order += "volume master"
order += "tztime local"

cpu_usage {
        format = "CPU %usage"
}

memory {
        format = "MEM %percentage_used"
        # turn the reading red when little memory is left
        threshold_degraded = "15%"
        threshold_critical = "5%"
        format_degraded = "MEM LOW %percentage_used"
}

disk "/" {
        format = "DISK %avail"
}

wireless {{ .wifi_interface }} {
        format_up = "WIFI %essid %quality"
        format_down = "WIFI down"
}

battery 0 {
        format = "%status %percentage %remaining"
        status_chr = "CHR"
        status_bat = "BAT"
        status_full = "FULL"
        status_unk = "UNK"
        low_threshold = 15
        integer_battery_capacity = true
}

# Uses i3status' PulseAudio support (Ubuntu build has it). If it errors,
# delete this block and the matching `order += "volume master"` line.
volume master {
        format = "VOL %volume"
        format_muted = "VOL muted"
        device = "pulse"
}

tztime local {
        format = "%a %Y-%m-%d %H:%M:%S"
}
