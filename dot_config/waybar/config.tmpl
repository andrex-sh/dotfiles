{{- /* Desktops have no /sys/class/power_supply/BAT*, and waybar renders the
       battery module as a permanent dead reading rather than hiding it. The
       power-profile menu is gated separately, on the daemon rather than on the
       battery: desktops have power profiles too. */ -}}
{{- $hasBattery := glob "/sys/class/power_supply/BAT*" -}}
// waybar - sway laptop, plain-text labels (replaces the old i3status bar)
{
    "layer": "top",
    "position": "top",

    "modules-left": ["sway/workspaces"],
    "modules-right": [
        "sway/language",
        "cpu",
        "memory",
{{ if $hasBattery }}        "battery",
{{ end }}        "pulseaudio",
        "clock",
        "tray",
        "custom/power"
    ],

    "sway/language": {
        "format": "{short}"
    },

    "cpu": {
        "interval": 5,
        "format": "CPU {usage}%"
    },

    "memory": {
        "interval": 5,
        "format": "MEM {percentage}%",
        "states": {
            "warning": 85,
            "critical": 95
        }
    },

    "battery": {
        "states": {
            "warning": 15
        },
        "format": "BAT {capacity}% {time}",
        "format-charging": "CHR {capacity}% {time}",
        "format-full": "FULL {capacity}%"
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL muted",
        "on-click": "pavucontrol"
    },

    "clock": {
        "format": "{:%a %Y-%m-%d %H:%M:%S}",
        "interval": 1
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    },

    // Sits to the right of the tray (so right of nm-applet's icon). Opens a
    // swaynag with lock/logout/suspend/poweroff and, where a power-profiles
    // daemon is present, a nested power-profile menu - see
    // ~/.config/sway/powermenu.sh.
    "custom/power": {
        "format": "PWR",
        "tooltip": false,
        "on-click": "$HOME/.config/sway/powermenu.sh"
    }
}
