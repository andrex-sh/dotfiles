// waybar - sway laptop (replaces the old i3status bar); hardware block uses
// Nerd Font icons, everything else stays plain text
{
    "layer": "top",
    "position": "top",
    "modules-left": [
        "custom/power",
        "sway/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "sway/language",
        "custom/hardware",
        "pulseaudio",
        "custom/notification",
        "tray"
    ],
    "sway/language": {
        "format": "{short}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },
    "custom/hardware": {
        "exec": "$HOME/.config/sway/hwstatus.sh",
        "return-type": "json",
        "interval": 3,
        "on-click": "foot --app-id=foot-btop -e btop"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " {volume}%",
        "format-icons": {
            "default": [
                "",
                ""
            ]
        },
        "on-click": "swaync-client -t -sw",
        "on-click-right": "$HOME/.config/sway/pavucontrol-toggle.sh"
    },
    "custom/notification": {
        "tooltip": true,
        "format": "<span size='16pt'>{icon}</span>",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "clock": {
        "format": "{:%a %Y-%m-%d %H:%M:%S}",
        "interval": 1,
        "tooltip": false,
        "on-click": "gsimplecal"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8
    },
    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "$HOME/.config/sway/powermenu.sh"
    }
}
