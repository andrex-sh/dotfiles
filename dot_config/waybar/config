// waybar - sway laptop, plain-text labels (replaces the old i3status bar)
{
    "layer": "top",
    "position": "top",

    "modules-left": ["sway/workspaces"],
    "modules-right": [
        "sway/language",
        "cpu",
        "memory",
        "battery",
        "pulseaudio",
        "clock",
        "tray"
    ],

    "sway/language": {
        "format": "{short}"
    },

    "cpu": {
        "interval": 5,
        "format": "CPU {usage}%"
    },

    "memory": {
        "interval": 5,
        "format": "MEM {percentage}%",
        "states": {
            "warning": 85,
            "critical": 95
        }
    },

    "battery": {
        "states": {
            "warning": 15
        },
        "format": "BAT {capacity}% {time}",
        "format-charging": "CHR {capacity}% {time}",
        "format-full": "FULL {capacity}%"
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL muted",
        "on-click": "pavucontrol"
    },

    "clock": {
        "format": "{:%a %Y-%m-%d %H:%M:%S}",
        "interval": 1
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    }
}
